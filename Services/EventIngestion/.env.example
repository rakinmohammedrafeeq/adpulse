# Event Ingestion Service Configuration

# Server
NODE_ENV=development
PORT=3001
EVENT_SERVICE_PORT=3001

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# API
API_BASE_URL=http://localhost:5000

# Processing
BATCH_SIZE=100
CONSUMER_INTERVAL_MS=5000

# Logging
LOG_LEVEL=info
LOGSTASH_HOST=localhost
LOGSTASH_PORT=5044
