# AdPulse - Environment Configuration Template
# Copy this file to .env and update with your local values

# ===== DATABASE =====
DB_HOST=localhost
DB_PORT=1433
DB_NAME=AdPulse
DB_USER=sa
DB_PASSWORD=AdPulse2026!
CONNECTION_STRING=Server=${DB_HOST},${DB_PORT};Database=${DB_NAME};User Id=${DB_USER};Password=${DB_PASSWORD};TrustServerCertificate=True;MultipleActiveResultSets=True

# ===== REDIS =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CONNECTION_STRING=${REDIS_HOST}:${REDIS_PORT}

# ===== ELASTICSEARCH =====
ELASTICSEARCH_URI=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=adpulse

# ===== LOGSTASH =====
LOGSTASH_HOST=localhost
LOGSTASH_PORT=5044

# ===== KIBANA =====
KIBANA_URI=http://localhost:5601

# ===== JWT AUTHENTICATION =====
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ISSUER=AdPulse
JWT_AUDIENCE=AdPulse.API
JWT_EXPIRY_MINUTES=60

# ===== API CONFIGURATION =====
API_BASE_URL=http://localhost:5000
API_PORT=5000
ASPNETCORE_ENVIRONMENT=Development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== FRONTEND CONFIGURATION =====
VITE_API_BASE_URL=http://localhost:5000
VITE_APP_TITLE=AdPulse Campaign Manager

# ===== EVENT INGESTION SERVICE =====
EVENT_SERVICE_PORT=3001
EVENT_SERVICE_HOST=localhost
NODE_ENV=development
LOG_LEVEL=info

# ===== FEATURE FLAGS =====
ENABLE_SWAGGER=true
ENABLE_DETAILED_ERRORS=true
ENABLE_RATE_LIMITING=true

# ===== AZURE (FUTURE USE - NOT CURRENTLY ACTIVE) =====
# Uncomment and populate these when deploying to Azure.
# Local development does NOT require any of these values.
#
# AZURE_TENANT_ID=
# AZURE_SUBSCRIPTION_ID=
# AZURE_RESOURCE_GROUP=adpulse-rg
#
# Azure Container Registry
# AZURE_REGISTRY_NAME=adpulseacr
# AZURE_REGISTRY_LOGIN_SERVER=adpulseacr.azurecr.io
#
# Azure SQL Database (replaces local SQL Server on port 1433)
# AZURE_SQL_SERVER=adpulse-sqlserver.database.windows.net
# AZURE_SQL_DATABASE=AdPulse
# AZURE_SQL_USER=adpulse_admin
# AZURE_SQL_PASSWORD=
#
# Azure Cache for Redis (replaces local Redis on port 6379)
# AZURE_REDIS_HOST=adpulse-cache.redis.cache.windows.net
# AZURE_REDIS_PORT=6380
# AZURE_REDIS_PASSWORD=
#
# Azure Key Vault (for secrets in production)
# AZURE_KEY_VAULT_URI=https://adpulse-keyvault.vault.azure.net/
#
# Azure App Configuration
# AZURE_APP_CONFIGURATION_URI=https://adpulse-appconfig.azconfig.io
#
# Azure Monitor / Application Insights
# APPLICATIONINSIGHTS_CONNECTION_STRING=
